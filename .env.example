# Supabase — copy to .env and fill in from your Supabase project settings.
# VITE_* values are baked into the browser bundle at build time (they are
# PUBLISHABLE keys by design — never put the service-role key here).

# Browser + SSR (publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (TanStack server functions read process.env.*)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SECURITY: service-role key bypasses RLS. Server-only — never expose to the
# client bundle, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
